# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle caches and build state (never commit)
android/.gradle/
*.gradle.kts-e

# Root package-lock.json is vestigial (no root package.json); backend keeps its own.
/package-lock.json

# Firebase
# firebase_options.dart is tracked on purpose (public config, required for builds).
# Native Firebase config files are kept local (not committed).
google-services.json
GoogleService-Info.plist
*.apk

# Firebase service account (backend push notifications) - NEVER commit.
firebase-service-account*.json

# Python / ML service
venv/
__pycache__/
*.pkl

{
  "name": "mindtwin-backend",
  "version": "1.0.0",
  "description": "MindTwin mental health backend - API server for therapist-patient sync",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "migrate": "node scripts/migrate.js",
    "start:pm2": "npx pm2 start index.js --name mindtwin-backend --time",
    "stop:pm2": "npx pm2 stop mindtwin-backend",
    "restart:pm2": "npx pm2 restart mindtwin-backend",
    "logs:pm2": "npx pm2 logs mindtwin-backend",
    "save:pm2": "npx pm2 save"
  },
  "dependencies": {
    "axios": "^1.3.4",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "firebase-admin": "^13.7.0",
    "jsonwebtoken": "^9.0.0",
    "pdfkit": "^0.17.2",
    "better-sqlite3": "^11.8.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^2.0.20",
    "pm2": "^6.0.14"
  },
  "keywords": [
    "mental-health",
    "therapist",
    "patient",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}

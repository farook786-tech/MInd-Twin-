PORT=5000
NODE_ENV=development
DATABASE=./mindtwin.db
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:8080
LOG_LEVEL=debug

# ML microservice (FastAPI) URL used by the crisis-detection bridge
ML_SERVICE_URL=http://127.0.0.1:8000

# OpenRouter API Configuration (for AI/LLM features)
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4-turbo

# Gemini API Configuration (used by /api/gemini/chat)
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

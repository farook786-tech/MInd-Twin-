{
  "name": "mindtwin-firestore-rules-tests",
  "private": true,
  "description": "Firestore security rules tests (run against the emulator)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"*.test.js\"",
    "test:emulator": "firebase --config ../../firebase.json emulators:exec --only firestore --project demo-mindtwin \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0"
  }
}
